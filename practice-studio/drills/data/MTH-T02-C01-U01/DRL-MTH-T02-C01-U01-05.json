    {
      "category": "Cross-Subject Application",
      "context": "Graphics and Algorithms Application",
      "references": [
        "PRG-T01-C03"
      ],
      "prompt": "In a 2D game engine, points are stored as complex numbers $z = x + yi$. Multiplying by $-1$ rotates a point $180^\\circ$ about the origin. The point $(-5, -3)$ is rotated $180^\\circ$ and then translated by $w = -2 + 5i$. Find the new point $(x', y')$.",
      "display": "z' = -1 \\cdot (-5 - 3i) + (-2 + 5i)",
      "plainText": "(-1)*(-5 - 3i) + (-2 + 5i)",
      "answerSpec": {
        "type": "tuple",
        "values": [
          "3",
          "8"
        ],
        "labels": [
          "x'",
          "y'"
        ],
        "acceptComplex": true
      },
      "answerDisplay": "(3, 8)",
      "answerPlain": "(3, 8)",
      "inputHint": "e.g. (5, 3)  or  5 + 3i",
      "checkpointHint": "After the rotation only, the point is $(5, 3)$.",
      "commonTrapTag": "sign-slip",
      "steps": [
        {
          "latex": "z = -5 - 3i",
          "explain": "Represent the point $(-5, -3)$ as a complex number."
        },
        {
          "latex": "-1\\cdot(-5 - 3i) = 5 + 3i",
          "explain": "Multiplying by $-1$ negates both coordinates (a half turn)."
        },
        {
          "latex": "z' = (5 + 3i) + (-2 + 5i) = 3 + 8i",
          "explain": "Add the translation $w$ component-wise. The new point is $(3, 8)$."
        }
      ],
