    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: Parallel Impedance",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "Two branches with impedances $Z_1 = 6 - 4i$ ohms and $Z_2 = 3 + 2i$ ohms are connected in parallel. Find the equivalent impedance $Z_{eq} = \\dfrac{Z_1 Z_2}{Z_1 + Z_2}$ in standard form $a + bi$.",
      "display": "Z_{eq} = \\frac{(6 - 4i)(3 + 2i)}{(6 - 4i) + (3 + 2i)}",
      "plainText": "((6 - 4i)*(3 + 2i))/((6 - 4i) + (3 + 2i))",
      "answerSpec": {
        "type": "complex",
        "value": "234/85 + (52/85)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{234}{85} + \\frac{52}{85}i",
      "answerPlain": "(234/85) + (52/85)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Compute the product first: $Z_1 Z_2 = 26$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "Z_1 Z_2 = (6 - 4i)(3 + 2i) = 26",
          "explain": "Multiply the impedances (FOIL, then $i^2 = -1$)."
        },
        {
          "latex": "Z_1 + Z_2 = 9 - 2i",
          "explain": "Add the real parts and the imaginary parts."
        },
        {
          "latex": "Z_{eq} = \\frac{26}{9 - 2i} = \\frac{(26)(9 + 2i)}{(9 - 2i)(9 + 2i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $9 + 2i$ of the denominator."
        },
        {
          "latex": "= \\frac{234 + 52i}{9^2 + (-2)^2}",
          "explain": "Expand the numerator with FOIL. The denominator is $(c + di)(c - di) = c^2 + d^2$ (always a plus sign)."
        },
        {
          "latex": "= \\frac{234 + 52i}{85}",
          "explain": "Substitute $i^2 = -1$ and combine like terms."
        },
        {
          "latex": "= \\frac{234}{85} + \\frac{52}{85}i",
          "explain": "Split into real and imaginary parts and reduce each fraction."
        }
      ],
