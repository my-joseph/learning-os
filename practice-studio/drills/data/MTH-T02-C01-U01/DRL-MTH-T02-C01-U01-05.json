      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "In an AC circuit the voltage phasor is $V = 100$ volts and the impedance is $Z = 4 - 3i$ ohms. Using Ohm's law $I = \\dfrac{V}{Z}$, find the current phasor $I$ in standard form $a + bi$ (amperes).",
      "display": "I = \\frac{100}{4 - 3i}",
      "plainText": "100/(4 - 3i)",
      "answerSpec": {
        "type": "complex",
        "value": "16 + (12)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "16 + 12i",
      "answerPlain": "16 + 12i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Multiply by the conjugate $4 + 3i$; the denominator becomes $25$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "I = \\frac{V}{Z} = \\frac{100}{4 - 3i}",
          "explain": "Substitute the given voltage and impedance into Ohm's law."
        },
        {
          "latex": "= \\frac{100(4 + 3i)}{(4 - 3i)(4 + 3i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $4 + 3i$."
        },
        {
          "latex": "= \\frac{400 + 300i}{4^2 + (-3)^2}",
          "explain": "Distribute in the numerator; the denominator is $R^2 + X^2$."
        },
        {
          "latex": "= 16 + 12i",
          "explain": "Divide both parts by $25$ and reduce. The real part is the in-phase current; the imaginary part is the reactive (quadrature) current."
        }
      ],
