      "category": "Core Skill",
      "prompt": "Write the number in standard form $a + bi$ with the radical fully simplified.",
      "display": "6 + \\sqrt{-18}",
      "plainText": "6 + sqrt(-18)",
      "answerSpec": {
        "type": "complex",
        "value": "6 + 3*sqrt(2)*I",
        "forms": [
          "a+bi",
          "simplified_radical"
        ]
      },
      "answerDisplay": "6 + 3\\sqrt{2}\\,i",
      "answerPlain": "6 + 3sqrt(2) i",
      "inputHint": "e.g. 5 + 3sqrt(2) i or 2 - 4sqrt(3) i",
      "checkpointHint": "Factor the radicand as $18 = 9 \\cdot 2$ and use $\\sqrt{-1} = i$.",
      "commonTrapTag": "radical-simplify",
      "steps": [
        {
          "latex": "6 + \\sqrt{-18} = 6 + \\sqrt{-1}\\cdot\\sqrt{18}",
          "explain": "Split off the factor $-1$. This is valid here because only one radicand is negative."
        },
        {
          "latex": "= 6 + i\\sqrt{9\\cdot 2}",
          "explain": "Replace $\\sqrt{-1}$ with $i$ and factor out the largest perfect square $9$."
        },
        {
          "latex": "= 6 + 3\\sqrt{2}\\,i",
          "explain": "Take $\\sqrt{9} = 3$ outside the radical. Real part $6$, imaginary part $3\\sqrt{2}$."
        }
      ],
