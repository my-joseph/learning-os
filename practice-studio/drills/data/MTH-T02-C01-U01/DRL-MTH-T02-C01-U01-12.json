    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: Parallel Impedance",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "Two branches with impedances $Z_1 = 2 + 2i$ ohms and $Z_2 = 6 + 5i$ ohms are connected in parallel. Find the equivalent impedance $Z_{eq} = \\dfrac{Z_1 Z_2}{Z_1 + Z_2}$ in standard form $a + bi$.",
      "display": "Z_{eq} = \\frac{(2 + 2i)(6 + 5i)}{(2 + 2i) + (6 + 5i)}",
      "plainText": "((2 + 2i)*(6 + 5i))/((2 + 2i) + (6 + 5i))",
      "answerSpec": {
        "type": "complex",
        "value": "170/113 + (162/113)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{170}{113} + \\frac{162}{113}i",
      "answerPlain": "(170/113) + (162/113)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Compute the product first: $Z_1 Z_2 = 2 + 22i$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "Z_1 Z_2 = (2 + 2i)(6 + 5i) = 2 + 22i",
          "explain": "Multiply the impedances (FOIL, then $i^2 = -1$)."
        },
        {
          "latex": "Z_1 + Z_2 = 8 + 7i",
          "explain": "Add the real parts and the imaginary parts."
        },
        {
          "latex": "Z_{eq} = \\frac{2 + 22i}{8 + 7i} = \\frac{(2 + 22i)(8 - 7i)}{(8 + 7i)(8 - 7i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $8 - 7i$ of the denominator."
        },
        {
          "latex": "= \\frac{16 - 14i + 176i - 154i^2}{8^2 + 7^2}",
          "explain": "Expand the numerator with FOIL. The denominator is $(c + di)(c - di) = c^2 + d^2$ (always a plus sign)."
        },
        {
          "latex": "= \\frac{170 + 162i}{113}",
          "explain": "Substitute $i^2 = -1$ and combine like terms."
        },
        {
          "latex": "= \\frac{170}{113} + \\frac{162}{113}i",
          "explain": "Split into real and imaginary parts and reduce each fraction."
        }
      ],
