      "form": "reciprocal",
      "category": "Multiplicative Inverse",
      "skill": "MTH-COMPLEX-DIVISION-CONJUGATE",
      "level": 2,
      "verificationLevel": "machine-verified",
      "prompt": "Find the reciprocal (multiplicative inverse) of $z = -3 - i$ in standard form $a + bi$.",
      "display": "\\frac{1}{-3 - i}",
      "plainText": "1/(-3 - i)",
