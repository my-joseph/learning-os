      "answerDisplay": "-\\frac{3}{10} + \\frac{1}{10}i",
      "answerPlain": "(-3/10) + (1/10)i",
      "inputHint": "Enter complex number in standard form a + bi (fractions allowed)",
      "checkpointHint": "The conjugate of $-3 - i$ is $-3 + i$; denominator is $10$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "\\frac{1}{-3 - i} = \\frac{1 \\cdot (-3 + i)}{(-3 - i)(-3 + i)}",
          "explain": "Multiply numerator and denominator by the complex conjugate $-3 + i$."
        },
