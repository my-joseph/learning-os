    {
      "category": "Cross-Subject Application",
      "context": "Graphics and Algorithms Application",
      "references": [
        "PRG-T01-C03"
      ],
      "prompt": "In a 2D game engine, points are stored as complex numbers $z = x + yi$. Multiplying by $i$ rotates a point $90^\\circ counterclockwise$ about the origin. The point $(-3, 6)$ is rotated $90^\\circ counterclockwise$ and then translated by $w = 6 - i$. Find the new point $(x', y')$.",
      "display": "z' = i(-3 + 6i) + (6 - i)",
      "plainText": "(i)*(-3 + 6i) + (6 - i)",
      "answerSpec": {
        "type": "tuple",
        "values": [
          "0",
          "-4"
        ],
        "labels": [
          "x'",
          "y'"
        ],
        "acceptComplex": true
      },
      "answerDisplay": "(0, -4)",
      "answerPlain": "(0, -4)",
      "inputHint": "e.g. (5, 3)  or  5 + 3i",
      "checkpointHint": "After the rotation only, the point is $(-6, -3)$.",
      "commonTrapTag": "sign-slip",
      "steps": [
        {
          "latex": "z = -3 + 6i",
          "explain": "Represent the point $(-3, 6)$ as a complex number."
        },
        {
          "latex": "i(-3 + 6i) = -3i + 6i^2 = -6 - 3i",
          "explain": "Multiply by $i$ and use $i^2 = -1$: the point $(x, y)$ maps to $(-y, x)$."
        },
        {
          "latex": "z' = (-6 - 3i) + (6 - i) = -4i",
          "explain": "Add the translation $w$ component-wise. The new point is $(0, -4)$."
        }
      ],
