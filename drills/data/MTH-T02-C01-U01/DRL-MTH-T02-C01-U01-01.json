    {
      "form": "direct",
      "category": "Cross-Subject Application",
      "context": "Physics Application: AC Circuits",
      "references": [
        "MTH-T02-C01-U01",
        "PHY-T01-C19"
      ],
      "prompt": "In an AC circuit the voltage phasor is $V = 100$ volts and the impedance is $Z = 8 - 6i$ ohms. Using Ohm's law $I = \\dfrac{V}{Z}$, find the current phasor $I$ in standard form $a + bi$ (amperes).",
      "display": "I = \\frac{100}{8 - 6i}",
      "plainText": "100/(8 - 6i)",
      "answerSpec": {
        "type": "complex",
        "value": "8 + (6)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "8 + 6i",
      "answerPlain": "8 + 6i",
      "inputHint": "Standard form: a + bi",
      "checkpointHint": "Multiply numerator and denominator by the complex conjugate of the denominator, then simplify.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "I = \\frac{V}{Z} = \\frac{100}{8 - 6i}",
          "explain": "Substitute the given voltage and impedance into Ohm's law."
        },
        {
          "latex": "= \\frac{100(8 + 6i)}{(8 - 6i)(8 + 6i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $8 + 6i$."
        },
        {
          "latex": "= \\frac{800 + 600i}{8^2 + (-6)^2}",
          "explain": "Distribute in the numerator; the denominator is $R^2 + X^2$."
        },
        {
          "latex": "= 8 + 6i",
          "explain": "Divide both parts by $100$ and reduce. The real part is the in-phase current; the imaginary part is the reactive (quadrature) current."
        }
