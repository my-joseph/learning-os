    {
      "category": "Combined with Prior Units",
      "prompt": "Let $f(x) = x^2 - 2x + 10$. Evaluate $f(1 + 3i)$ and write the result in standard form $a + bi$.",
      "display": "f(1 + 3i) = (1 + 3i)^2 - 2(1 + 3i) + 10",
      "plainText": "(1 + 3i)^2 + (-2)*(1 + 3i) + (10)",
      "answerSpec": {
        "type": "complex",
        "value": "0 + (0)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "0",
      "answerPlain": "0",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "First compute $(1 + 3i)^2 = -8 + 6i$.",
      "commonTrapTag": "sign-slip",
      "steps": [
        {
          "latex": "f(1 + 3i) = (1 + 3i)^2 - 2(1 + 3i) + 10",
          "explain": "Substitute the complex number for every $x$, keeping it in parentheses."
        },
        {
          "latex": "= (-8 + 6i) + (-2 - 6i) + 10",
          "explain": "Square first: $(1 + 3i)^2 = 1^2 + 2(1)(3i) + (3i)^2 = -8 + 6i$. Then distribute $-2$."
        },
        {
          "latex": "= 0",
          "explain": "Add the real parts and the imaginary parts separately. A result of $0$ means the number is a root of $f$."
        }
      ],
