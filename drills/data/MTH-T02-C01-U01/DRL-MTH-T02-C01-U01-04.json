    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: Parallel Impedance",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "Two branches with impedances $Z_1 = 4 + 2i$ ohms and $Z_2 = 1 - 3i$ ohms are connected in parallel. Find the equivalent impedance $Z_{eq} = \\dfrac{Z_1 Z_2}{Z_1 + Z_2}$ in standard form $a + bi$.",
      "display": "Z_{eq} = \\frac{(4 + 2i)(1 - 3i)}{(4 + 2i) + (1 - 3i)}",
      "plainText": "((4 + 2i)*(1 - 3i))/((4 + 2i) + (1 - 3i))",
      "answerSpec": {
        "type": "complex",
        "value": "30/13 + (-20/13)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{30}{13} - \\frac{20}{13}i",
      "answerPlain": "(30/13) - (20/13)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Compute the product first: $Z_1 Z_2 = 10 - 10i$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "Z_1 Z_2 = (4 + 2i)(1 - 3i) = 10 - 10i",
          "explain": "Multiply the impedances (FOIL, then $i^2 = -1$)."
        },
        {
          "latex": "Z_1 + Z_2 = 5 - i",
          "explain": "Add the real parts and the imaginary parts."
        },
        {
          "latex": "Z_{eq} = \\frac{10 - 10i}{5 - i} = \\frac{(10 - 10i)(5 + i)}{(5 - i)(5 + i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $5 + i$ of the denominator."
        },
        {
          "latex": "= \\frac{50 + 10i - 50i - 10i^2}{5^2 + (-1)^2}",
          "explain": "Expand the numerator with FOIL. The denominator is $(c + di)(c - di) = c^2 + d^2$ (always a plus sign)."
        },
        {
          "latex": "= \\frac{60 - 40i}{26}",
          "explain": "Substitute $i^2 = -1$ and combine like terms."
        },
        {
          "latex": "= \\frac{30}{13} - \\frac{20}{13}i",
          "explain": "Split into real and imaginary parts and reduce each fraction."
        }
      ],
