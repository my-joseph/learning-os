    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: AC Circuits",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "In an AC circuit the voltage phasor is $V = 52$ volts and the impedance is $Z = 2 - i$ ohms. Using Ohm's law $I = \\dfrac{V}{Z}$, find the current phasor $I$ in standard form $a + bi$ (amperes).",
      "display": "I = \\frac{52}{2 - i}",
      "plainText": "52/(2 - i)",
      "answerSpec": {
        "type": "complex",
        "value": "104/5 + (52/5)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{104}{5} + \\frac{52}{5}i",
      "answerPlain": "(104/5) + (52/5)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Multiply by the conjugate $2 + i$; the denominator becomes $5$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "I = \\frac{V}{Z} = \\frac{52}{2 - i}",
          "explain": "Substitute the given voltage and impedance into Ohm's law."
        },
        {
          "latex": "= \\frac{52(2 + i)}{(2 - i)(2 + i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $2 + i$."
        },
        {
          "latex": "= \\frac{104 + 52i}{2^2 + (-1)^2}",
          "explain": "Distribute in the numerator; the denominator is $R^2 + X^2$."
        },
        {
          "latex": "= \\frac{104}{5} + \\frac{52}{5}i",
          "explain": "Divide both parts by $5$ and reduce. The real part is the in-phase current; the imaginary part is the reactive (quadrature) current."
        }
      ],
