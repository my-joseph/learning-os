    {
      "category": "Cross-Subject Application",
      "context": "Graphics and Algorithms Application",
      "references": [
        "PRG-T01-C03"
      ],
      "prompt": "In a 2D game engine, points are stored as complex numbers $z = x + yi$. Multiplying by $-i$ rotates a point $90^\\circ clockwise$ about the origin. The point $(7, 6)$ is rotated $90^\\circ clockwise$ and then translated by $w = 4 + 4i$. Find the new point $(x', y')$.",
      "display": "z' = -i(7 + 6i) + (4 + 4i)",
      "plainText": "(-i)*(7 + 6i) + (4 + 4i)",
      "answerSpec": {
        "type": "tuple",
        "values": [
          "10",
          "-3"
        ],
        "labels": [
          "x'",
          "y'"
        ],
        "acceptComplex": true
      },
      "answerDisplay": "(10, -3)",
      "answerPlain": "(10, -3)",
      "inputHint": "e.g. (5, 3)  or  5 + 3i",
      "checkpointHint": "After the rotation only, the point is $(6, -7)$.",
      "commonTrapTag": "sign-slip",
      "steps": [
        {
          "latex": "z = 7 + 6i",
          "explain": "Represent the point $(7, 6)$ as a complex number."
        },
        {
          "latex": "-i(7 + 6i) = -7i - 6i^2 = 6 - 7i",
          "explain": "Multiply by $-i$ and use $i^2 = -1$: the point $(x, y)$ maps to $(y, -x)$."
        },
        {
          "latex": "z' = (6 - 7i) + (4 + 4i) = 10 - 3i",
          "explain": "Add the translation $w$ component-wise. The new point is $(10, -3)$."
        }
      ],
