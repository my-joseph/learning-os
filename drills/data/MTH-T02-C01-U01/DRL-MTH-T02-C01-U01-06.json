    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: AC Circuits",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "In an AC circuit the voltage phasor is $V = 65$ volts and the impedance is $Z = 5 - 12i$ ohms. Using Ohm's law $I = \\dfrac{V}{Z}$, find the current phasor $I$ in standard form $a + bi$ (amperes).",
      "display": "I = \\frac{65}{5 - 12i}",
      "plainText": "65/(5 - 12i)",
      "answerSpec": {
        "type": "complex",
        "value": "25/13 + (60/13)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{25}{13} + \\frac{60}{13}i",
      "answerPlain": "(25/13) + (60/13)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Multiply by the conjugate $5 + 12i$; the denominator becomes $169$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "I = \\frac{V}{Z} = \\frac{65}{5 - 12i}",
          "explain": "Substitute the given voltage and impedance into Ohm's law."
        },
        {
          "latex": "= \\frac{65(5 + 12i)}{(5 - 12i)(5 + 12i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $5 + 12i$."
        },
        {
          "latex": "= \\frac{325 + 780i}{5^2 + (-12)^2}",
          "explain": "Distribute in the numerator; the denominator is $R^2 + X^2$."
        },
        {
          "latex": "= \\frac{25}{13} + \\frac{60}{13}i",
          "explain": "Divide both parts by $169$ and reduce. The real part is the in-phase current; the imaginary part is the reactive (quadrature) current."
        }
      ],
      "id": "Q02",
      "templateKey": "ac-current",
