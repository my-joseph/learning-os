    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: Parallel Impedance",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "Two branches with impedances $Z_1 = 4 + i$ ohms and $Z_2 = 6 + i$ ohms are connected in parallel. Find the equivalent impedance $Z_{eq} = \\dfrac{Z_1 Z_2}{Z_1 + Z_2}$ in standard form $a + bi$.",
      "display": "Z_{eq} = \\frac{(4 + i)(6 + i)}{(4 + i) + (6 + i)}",
      "plainText": "((4 + i)*(6 + i))/((4 + i) + (6 + i))",
      "answerSpec": {
        "type": "complex",
        "value": "125/52 + (27/52)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{125}{52} + \\frac{27}{52}i",
      "answerPlain": "(125/52) + (27/52)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Compute the product first: $Z_1 Z_2 = 23 + 10i$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "Z_1 Z_2 = (4 + i)(6 + i) = 23 + 10i",
          "explain": "Multiply the impedances (FOIL, then $i^2 = -1$)."
        },
        {
          "latex": "Z_1 + Z_2 = 10 + 2i",
          "explain": "Add the real parts and the imaginary parts."
        },
        {
          "latex": "Z_{eq} = \\frac{23 + 10i}{10 + 2i} = \\frac{(23 + 10i)(10 - 2i)}{(10 + 2i)(10 - 2i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $10 - 2i$ of the denominator."
        },
        {
          "latex": "= \\frac{230 - 46i + 100i - 20i^2}{10^2 + 2^2}",
          "explain": "Expand the numerator with FOIL. The denominator is $(c + di)(c - di) = c^2 + d^2$ (always a plus sign)."
        },
        {
          "latex": "= \\frac{250 + 54i}{104}",
          "explain": "Substitute $i^2 = -1$ and combine like terms."
        },
        {
          "latex": "= \\frac{125}{52} + \\frac{27}{52}i",
          "explain": "Split into real and imaginary parts and reduce each fraction."
        }
      ],
