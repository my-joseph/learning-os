  "problems": [
    {
      "category": "Cross-Subject Application",
      "context": "Graphics and Algorithms Application",
      "references": [
        "PRG-T01-C03"
      ],
      "prompt": "In a 2D game engine, points are stored as complex numbers $z = x + yi$. Multiplying by $i$ rotates a point $90^\\circ counterclockwise$ about the origin. The point $(1, 5)$ is rotated $90^\\circ counterclockwise$ and then translated by $w = -3 + i$. Find the new point $(x', y')$.",
      "display": "z' = i(1 + 5i) + (-3 + i)",
      "plainText": "(i)*(1 + 5i) + (-3 + i)",
      "answerSpec": {
        "type": "tuple",
        "values": [
          "-8",
          "2"
        ],
        "labels": [
          "x'",
          "y'"
        ],
        "acceptComplex": true
      },
      "answerDisplay": "(-8, 2)",
      "answerPlain": "(-8, 2)",
      "inputHint": "e.g. (5, 3)  or  5 + 3i",
      "checkpointHint": "After the rotation only, the point is $(-5, 1)$.",
      "commonTrapTag": "sign-slip",
      "steps": [
        {
          "latex": "z = 1 + 5i",
          "explain": "Represent the point $(1, 5)$ as a complex number."
        },
        {
          "latex": "i(1 + 5i) = i + 5i^2 = -5 + i",
          "explain": "Multiply by $i$ and use $i^2 = -1$: the point $(x, y)$ maps to $(-y, x)$."
        },
        {
          "latex": "z' = (-5 + i) + (-3 + i) = -8 + 2i",
          "explain": "Add the translation $w$ component-wise. The new point is $(-8, 2)$."
        }
      ],
      "id": "Q01",
      "templateKey": "rotation-2d",
      "level": 4,
      "levelLabel": "Level 4 - Applied Synthesis",
      "referenceBadges": [
