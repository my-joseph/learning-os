    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: Parallel Impedance",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "Two branches with impedances $Z_1 = 4 - 3i$ ohms and $Z_2 = 5 - 3i$ ohms are connected in parallel. Find the equivalent impedance $Z_{eq} = \\dfrac{Z_1 Z_2}{Z_1 + Z_2}$ in standard form $a + bi$.",
      "display": "Z_{eq} = \\frac{(4 - 3i)(5 - 3i)}{(4 - 3i) + (5 - 3i)}",
      "plainText": "((4 - 3i)*(5 - 3i))/((4 - 3i) + (5 - 3i))",
      "answerSpec": {
        "type": "complex",
        "value": "29/13 + (-59/39)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{29}{13} - \\frac{59}{39}i",
      "answerPlain": "(29/13) - (59/39)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Compute the product first: $Z_1 Z_2 = 11 - 27i$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "Z_1 Z_2 = (4 - 3i)(5 - 3i) = 11 - 27i",
          "explain": "Multiply the impedances (FOIL, then $i^2 = -1$)."
        },
        {
          "latex": "Z_1 + Z_2 = 9 - 6i",
          "explain": "Add the real parts and the imaginary parts."
        },
        {
          "latex": "Z_{eq} = \\frac{11 - 27i}{9 - 6i} = \\frac{(11 - 27i)(9 + 6i)}{(9 - 6i)(9 + 6i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $9 + 6i$ of the denominator."
        },
        {
          "latex": "= \\frac{99 + 66i - 243i - 162i^2}{9^2 + (-6)^2}",
          "explain": "Expand the numerator with FOIL. The denominator is $(c + di)(c - di) = c^2 + d^2$ (always a plus sign)."
        },
        {
          "latex": "= \\frac{261 - 177i}{117}",
          "explain": "Substitute $i^2 = -1$ and combine like terms."
        },
        {
          "latex": "= \\frac{29}{13} - \\frac{59}{39}i",
          "explain": "Split into real and imaginary parts and reduce each fraction."
        }
      ],
