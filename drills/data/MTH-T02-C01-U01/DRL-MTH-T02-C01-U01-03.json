    {
      "category": "Trap & Edge Case",
      "prompt": "A student multiplied two complex numbers as shown. Which line contains the FIRST error?",
      "display": "\\begin{aligned}&\\text{Line 1: }\\; (-6 + 4i)(6 + 3i) = -36 - 18i - 24i + 12i^2 \\\\ &\\text{Line 2: }\\; = -36 - 42i + 12(-1) \\\\ &\\text{Line 3: }\\; = -48 - 42i\\end{aligned}",
      "plainText": "(-6 + 4i)*(6 + 3i)",
      "answerSpec": {
        "type": "choice",
        "options": [
          {
            "id": "1",
            "label": "Line 1"
          },
          {
            "id": "2",
            "label": "Line 2"
          },
          {
            "id": "3",
            "label": "Line 3"
          }
        ],
        "correct": "1"
      },
      "answerDisplay": "\\text{Line 1}",
      "answerPlain": "1",
      "inputHint": "Choose a line",
      "checkpointHint": "Compute the product yourself first; the correct result is not $-48 - 42i$.",
      "commonTrapTag": "sign-slip",
      "steps": [
        {
          "latex": "(-6 + 4i)(6 + 3i) = -36 - 18i + 24i + 12i^2",
          "explain": "Line 1 is wrong: the Inner product is $(4i)(6) = 24i$, not $-24i$. Correct version shown. FOIL every pair of terms."
        },
        {
          "latex": "= -36 + 6i + 12(-1)",
          "explain": "Correct Line 2: combine imaginary terms and use $i^2 = -1$."
        },
        {
          "latex": "= -48 + 6i",
          "explain": "Correct Line 3: combine the real parts. The true product is $-48 + 6i$."
        }
      ],
