      "references": [
        "PRG-T01-C03"
      ],
      "prompt": "In a 2D game engine, points are stored as complex numbers $z = x + yi$. Multiplying by $i$ rotates a point $90^\\circ counterclockwise$ about the origin. The point $(-1, -5)$ is rotated $90^\\circ counterclockwise$ and then translated by $w = 6 - 5i$. Find the new point $(x', y')$.",
      "display": "z' = i(-1 - 5i) + (6 - 5i)",
      "plainText": "(i)*(-1 - 5i) + (6 - 5i)",
      "answerSpec": {
        "type": "tuple",
        "values": [
          "11",
          "-6"
        ],
        "labels": [
          "x'",
          "y'"
        ],
        "acceptComplex": true
      },
      "answerDisplay": "(11, -6)",
      "answerPlain": "(11, -6)",
      "inputHint": "e.g. (5, 3)  or  5 + 3i",
      "checkpointHint": "After the rotation only, the point is $(5, -1)$.",
      "commonTrapTag": "sign-slip",
      "steps": [
        {
          "latex": "z = -1 - 5i",
          "explain": "Represent the point $(-1, -5)$ as a complex number."
        },
        {
          "latex": "i(-1 - 5i) = -i - 5i^2 = 5 - i",
          "explain": "Multiply by $i$ and use $i^2 = -1$: the point $(x, y)$ maps to $(-y, x)$."
        },
        {
          "latex": "z' = (5 - i) + (6 - 5i) = 11 - 6i",
          "explain": "Add the translation $w$ component-wise. The new point is $(11, -6)$."
        }
      ],
