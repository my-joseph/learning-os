    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: Parallel Impedance",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "Two branches with impedances $Z_1 = 6 - 6i$ ohms and $Z_2 = 1 - 4i$ ohms are connected in parallel. Find the equivalent impedance $Z_{eq} = \\dfrac{Z_1 Z_2}{Z_1 + Z_2}$ in standard form $a + bi$.",
      "display": "Z_{eq} = \\frac{(6 - 6i)(1 - 4i)}{(6 - 6i) + (1 - 4i)}",
      "plainText": "((6 - 6i)*(1 - 4i))/((6 - 6i) + (1 - 4i))",
      "answerSpec": {
        "type": "complex",
        "value": "174/149 + (-390/149)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{174}{149} - \\frac{390}{149}i",
      "answerPlain": "(174/149) - (390/149)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Compute the product first: $Z_1 Z_2 = -18 - 30i$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "Z_1 Z_2 = (6 - 6i)(1 - 4i) = -18 - 30i",
          "explain": "Multiply the impedances (FOIL, then $i^2 = -1$)."
        },
        {
          "latex": "Z_1 + Z_2 = 7 - 10i",
          "explain": "Add the real parts and the imaginary parts."
        },
        {
          "latex": "Z_{eq} = \\frac{-18 - 30i}{7 - 10i} = \\frac{(-18 - 30i)(7 + 10i)}{(7 - 10i)(7 + 10i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $7 + 10i$ of the denominator."
        },
        {
          "latex": "= \\frac{-126 - 180i - 210i - 300i^2}{7^2 + (-10)^2}",
          "explain": "Expand the numerator with FOIL. The denominator is $(c + di)(c - di) = c^2 + d^2$ (always a plus sign)."
        },
        {
          "latex": "= \\frac{174 - 390i}{149}",
          "explain": "Substitute $i^2 = -1$ and combine like terms."
        },
        {
          "latex": "= \\frac{174}{149} - \\frac{390}{149}i",
          "explain": "Split into real and imaginary parts and reduce each fraction."
        }
      ],
