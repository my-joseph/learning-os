  "problems": [
    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: AC Circuits",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "In an AC circuit the voltage phasor is $V = 39$ volts and the impedance is $Z = 1 - 3i$ ohms. Using Ohm's law $I = \\dfrac{V}{Z}$, find the current phasor $I$ in standard form $a + bi$ (amperes).",
      "display": "I = \\frac{39}{1 - 3i}",
      "plainText": "39/(1 - 3i)",
      "answerSpec": {
        "type": "complex",
        "value": "39/10 + (117/10)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{39}{10} + \\frac{117}{10}i",
      "answerPlain": "(39/10) + (117/10)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Multiply by the conjugate $1 + 3i$; the denominator becomes $10$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "I = \\frac{V}{Z} = \\frac{39}{1 - 3i}",
          "explain": "Substitute the given voltage and impedance into Ohm's law."
        },
        {
          "latex": "= \\frac{39(1 + 3i)}{(1 - 3i)(1 + 3i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $1 + 3i$."
        },
        {
          "latex": "= \\frac{39 + 117i}{1^2 + (-3)^2}",
          "explain": "Distribute in the numerator; the denominator is $R^2 + X^2$."
        },
        {
          "latex": "= \\frac{39}{10} + \\frac{117}{10}i",
          "explain": "Divide both parts by $10$ and reduce. The real part is the in-phase current; the imaginary part is the reactive (quadrature) current."
        }
      ],
