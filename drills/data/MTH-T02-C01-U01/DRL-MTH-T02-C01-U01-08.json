    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: AC Circuits",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "In an AC circuit the voltage phasor is $V = 52$ volts and the impedance is $Z = 8 - 6i$ ohms. Using Ohm's law $I = \\dfrac{V}{Z}$, find the current phasor $I$ in standard form $a + bi$ (amperes).",
      "display": "I = \\frac{52}{8 - 6i}",
      "plainText": "52/(8 - 6i)",
      "answerSpec": {
        "type": "complex",
        "value": "104/25 + (78/25)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{104}{25} + \\frac{78}{25}i",
      "answerPlain": "(104/25) + (78/25)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Multiply by the conjugate $8 + 6i$; the denominator becomes $100$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "I = \\frac{V}{Z} = \\frac{52}{8 - 6i}",
          "explain": "Substitute the given voltage and impedance into Ohm's law."
        },
        {
          "latex": "= \\frac{52(8 + 6i)}{(8 - 6i)(8 + 6i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $8 + 6i$."
        },
        {
          "latex": "= \\frac{416 + 312i}{8^2 + (-6)^2}",
          "explain": "Distribute in the numerator; the denominator is $R^2 + X^2$."
        },
        {
          "latex": "= \\frac{104}{25} + \\frac{78}{25}i",
          "explain": "Divide both parts by $100$ and reduce. The real part is the in-phase current; the imaginary part is the reactive (quadrature) current."
        }
      ],
