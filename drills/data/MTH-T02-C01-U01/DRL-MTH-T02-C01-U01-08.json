    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: Parallel Impedance",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "Two branches with impedances $Z_1 = 4 - 4i$ ohms and $Z_2 = 5 - 2i$ ohms are connected in parallel. Find the equivalent impedance $Z_{eq} = \\dfrac{Z_1 Z_2}{Z_1 + Z_2}$ in standard form $a + bi$.",
      "display": "Z_{eq} = \\frac{(4 - 4i)(5 - 2i)}{(4 - 4i) + (5 - 2i)}",
      "plainText": "((4 - 4i)*(5 - 2i))/((4 - 4i) + (5 - 2i))",
      "answerSpec": {
        "type": "complex",
        "value": "92/39 + (-20/13)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{92}{39} - \\frac{20}{13}i",
      "answerPlain": "(92/39) - (20/13)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Compute the product first: $Z_1 Z_2 = 12 - 28i$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "Z_1 Z_2 = (4 - 4i)(5 - 2i) = 12 - 28i",
          "explain": "Multiply the impedances (FOIL, then $i^2 = -1$)."
        },
        {
          "latex": "Z_1 + Z_2 = 9 - 6i",
          "explain": "Add the real parts and the imaginary parts."
        },
        {
          "latex": "Z_{eq} = \\frac{12 - 28i}{9 - 6i} = \\frac{(12 - 28i)(9 + 6i)}{(9 - 6i)(9 + 6i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $9 + 6i$ of the denominator."
        },
        {
          "latex": "= \\frac{108 + 72i - 252i - 168i^2}{9^2 + (-6)^2}",
          "explain": "Expand the numerator with FOIL. The denominator is $(c + di)(c - di) = c^2 + d^2$ (always a plus sign)."
        },
        {
          "latex": "= \\frac{276 - 180i}{117}",
          "explain": "Substitute $i^2 = -1$ and combine like terms."
        },
        {
          "latex": "= \\frac{92}{39} - \\frac{20}{13}i",
          "explain": "Split into real and imaginary parts and reduce each fraction."
        }
      ],
