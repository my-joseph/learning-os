  "problems": [
    {
      "category": "Cross-Subject Application",
      "context": "Graphics and Algorithms Application",
      "references": [
        "PRG-T01-C03"
      ],
      "prompt": "In a 2D game engine, points are stored as complex numbers $z = x + yi$. Multiplying by $i$ rotates a point $90^\\circ counterclockwise$ about the origin. The point $(-5, -9)$ is rotated $90^\\circ counterclockwise$ and then translated by $w = -3 - i$. Find the new point $(x', y')$.",
      "display": "z' = i(-5 - 9i) + (-3 - i)",
      "plainText": "(i)*(-5 - 9i) + (-3 - i)",
      "answerSpec": {
        "type": "tuple",
        "values": [
          "6",
          "-6"
        ],
        "labels": [
          "x'",
          "y'"
        ],
        "acceptComplex": true
      },
      "answerDisplay": "(6, -6)",
      "answerPlain": "(6, -6)",
      "inputHint": "e.g. (5, 3)  or  5 + 3i",
      "checkpointHint": "After the rotation only, the point is $(9, -5)$.",
      "commonTrapTag": "sign-slip",
      "steps": [
        {
          "latex": "z = -5 - 9i",
          "explain": "Represent the point $(-5, -9)$ as a complex number."
        },
        {
          "latex": "i(-5 - 9i) = -5i - 9i^2 = 9 - 5i",
          "explain": "Multiply by $i$ and use $i^2 = -1$: the point $(x, y)$ maps to $(-y, x)$."
        },
        {
          "latex": "z' = (9 - 5i) + (-3 - i) = 6 - 6i",
          "explain": "Add the translation $w$ component-wise. The new point is $(6, -6)$."
        }
      ],
      "id": "Q01",
      "templateKey": "rotation-2d",
      "level": 4,
