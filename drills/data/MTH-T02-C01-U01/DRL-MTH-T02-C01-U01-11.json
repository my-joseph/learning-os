    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: Parallel Impedance",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "Two branches with impedances $Z_1 = 2 - 3i$ ohms and $Z_2 = 3 + 2i$ ohms are connected in parallel. Find the equivalent impedance $Z_{eq} = \\dfrac{Z_1 Z_2}{Z_1 + Z_2}$ in standard form $a + bi$.",
      "display": "Z_{eq} = \\frac{(2 - 3i)(3 + 2i)}{(2 - 3i) + (3 + 2i)}",
      "plainText": "((2 - 3i)*(3 + 2i))/((2 - 3i) + (3 + 2i))",
      "answerSpec": {
        "type": "complex",
        "value": "5/2 + (-1/2)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{5}{2} - \\frac{1}{2}i",
      "answerPlain": "(5/2) - (1/2)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Compute the product first: $Z_1 Z_2 = 12 - 5i$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "Z_1 Z_2 = (2 - 3i)(3 + 2i) = 12 - 5i",
          "explain": "Multiply the impedances (FOIL, then $i^2 = -1$)."
        },
        {
          "latex": "Z_1 + Z_2 = 5 - i",
          "explain": "Add the real parts and the imaginary parts."
        },
        {
          "latex": "Z_{eq} = \\frac{12 - 5i}{5 - i} = \\frac{(12 - 5i)(5 + i)}{(5 - i)(5 + i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $5 + i$ of the denominator."
        },
        {
          "latex": "= \\frac{60 + 12i - 25i - 5i^2}{5^2 + (-1)^2}",
          "explain": "Expand the numerator with FOIL. The denominator is $(c + di)(c - di) = c^2 + d^2$ (always a plus sign)."
        },
        {
          "latex": "= \\frac{65 - 13i}{26}",
          "explain": "Substitute $i^2 = -1$ and combine like terms."
        },
        {
          "latex": "= \\frac{5}{2} - \\frac{1}{2}i",
          "explain": "Split into real and imaginary parts and reduce each fraction."
        }
      ],
      "id": "Q02",
      "templateKey": "parallel-impedance",
      "level": 4,
      "levelLabel": "Level 4 - Applied Synthesis",
      "referenceBadges": [
