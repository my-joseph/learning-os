    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: AC Circuits",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "In an AC circuit the voltage phasor is $V = 50$ volts and the impedance is $Z = 1 + 2i$ ohms. Using Ohm's law $I = \\dfrac{V}{Z}$, find the current phasor $I$ in standard form $a + bi$ (amperes).",
      "display": "I = \\frac{50}{1 + 2i}",
      "plainText": "50/(1 + 2i)",
      "answerSpec": {
        "type": "complex",
        "value": "10 + (-20)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "10 - 20i",
      "answerPlain": "10 - 20i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Multiply by the conjugate $1 - 2i$; the denominator becomes $5$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "I = \\frac{V}{Z} = \\frac{50}{1 + 2i}",
          "explain": "Substitute the given voltage and impedance into Ohm's law."
        },
        {
          "latex": "= \\frac{50(1 - 2i)}{(1 + 2i)(1 - 2i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $1 - 2i$."
        },
        {
          "latex": "= \\frac{50 - 100i}{1^2 + 2^2}",
          "explain": "Distribute in the numerator; the denominator is $R^2 + X^2$."
        },
        {
          "latex": "= 10 - 20i",
          "explain": "Divide both parts by $5$ and reduce. The real part is the in-phase current; the imaginary part is the reactive (quadrature) current."
        }
      ],
