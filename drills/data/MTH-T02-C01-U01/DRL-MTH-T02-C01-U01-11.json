  "problems": [
    {
      "category": "Cross-Subject Application",
      "context": "Graphics and Algorithms Application",
      "references": [
        "PRG-T01-C03"
      ],
      "prompt": "In a 2D game engine, points are stored as complex numbers $z = x + yi$. Multiplying by $-1$ rotates a point $180^\\circ$ about the origin. The point $(-3, 4)$ is rotated $180^\\circ$ and then translated by $w = -1 - i$. Find the new point $(x', y')$.",
      "display": "z' = -1 \\cdot (-3 + 4i) + (-1 - i)",
      "plainText": "(-1)*(-3 + 4i) + (-1 - i)",
      "answerSpec": {
        "type": "tuple",
        "values": [
          "2",
          "-5"
        ],
        "labels": [
          "x'",
          "y'"
        ],
        "acceptComplex": true
      },
      "answerDisplay": "(2, -5)",
      "answerPlain": "(2, -5)",
      "inputHint": "e.g. (5, 3)  or  5 + 3i",
      "checkpointHint": "After the rotation only, the point is $(3, -4)$.",
      "commonTrapTag": "sign-slip",
      "steps": [
        {
          "latex": "z = -3 + 4i",
          "explain": "Represent the point $(-3, 4)$ as a complex number."
        },
        {
          "latex": "-1\\cdot(-3 + 4i) = 3 - 4i",
          "explain": "Multiplying by $-1$ negates both coordinates (a half turn)."
        },
        {
          "latex": "z' = (3 - 4i) + (-1 - i) = 2 - 5i",
          "explain": "Add the translation $w$ component-wise. The new point is $(2, -5)$."
        }
      ],
      "id": "Q01",
      "templateKey": "rotation-2d",
      "level": 4,
