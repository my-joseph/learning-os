    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: AC Circuits",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "In an AC circuit the voltage phasor is $V = 26$ volts and the impedance is $Z = 2 + 3i$ ohms. Using Ohm's law $I = \\dfrac{V}{Z}$, find the current phasor $I$ in standard form $a + bi$ (amperes).",
      "display": "I = \\frac{26}{2 + 3i}",
      "plainText": "26/(2 + 3i)",
      "answerSpec": {
        "type": "complex",
        "value": "4 + (-6)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "4 - 6i",
      "answerPlain": "4 - 6i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Multiply by the conjugate $2 - 3i$; the denominator becomes $13$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "I = \\frac{V}{Z} = \\frac{26}{2 + 3i}",
          "explain": "Substitute the given voltage and impedance into Ohm's law."
        },
        {
          "latex": "= \\frac{26(2 - 3i)}{(2 + 3i)(2 - 3i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $2 - 3i$."
        },
        {
          "latex": "= \\frac{52 - 78i}{2^2 + 3^2}",
          "explain": "Distribute in the numerator; the denominator is $R^2 + X^2$."
        },
        {
          "latex": "= 4 - 6i",
          "explain": "Divide both parts by $13$ and reduce. The real part is the in-phase current; the imaginary part is the reactive (quadrature) current."
        }
      ],
