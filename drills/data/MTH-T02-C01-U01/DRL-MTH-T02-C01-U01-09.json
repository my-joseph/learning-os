  "problems": [
    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: Parallel Impedance",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "Two branches with impedances $Z_1 = 6 + i$ ohms and $Z_2 = 1 - 3i$ ohms are connected in parallel. Find the equivalent impedance $Z_{eq} = \\dfrac{Z_1 Z_2}{Z_1 + Z_2}$ in standard form $a + bi$.",
      "display": "Z_{eq} = \\frac{(6 + i)(1 - 3i)}{(6 + i) + (1 - 3i)}",
      "plainText": "((6 + i)*(1 - 3i))/((6 + i) + (1 - 3i))",
      "answerSpec": {
        "type": "complex",
        "value": "97/53 + (-101/53)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{97}{53} - \\frac{101}{53}i",
      "answerPlain": "(97/53) - (101/53)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Compute the product first: $Z_1 Z_2 = 9 - 17i$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "Z_1 Z_2 = (6 + i)(1 - 3i) = 9 - 17i",
          "explain": "Multiply the impedances (FOIL, then $i^2 = -1$)."
        },
        {
          "latex": "Z_1 + Z_2 = 7 - 2i",
          "explain": "Add the real parts and the imaginary parts."
        },
        {
          "latex": "Z_{eq} = \\frac{9 - 17i}{7 - 2i} = \\frac{(9 - 17i)(7 + 2i)}{(7 - 2i)(7 + 2i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $7 + 2i$ of the denominator."
        },
        {
          "latex": "= \\frac{63 + 18i - 119i - 34i^2}{7^2 + (-2)^2}",
          "explain": "Expand the numerator with FOIL. The denominator is $(c + di)(c - di) = c^2 + d^2$ (always a plus sign)."
        },
        {
          "latex": "= \\frac{97 - 101i}{53}",
          "explain": "Substitute $i^2 = -1$ and combine like terms."
        },
        {
          "latex": "= \\frac{97}{53} - \\frac{101}{53}i",
          "explain": "Split into real and imaginary parts and reduce each fraction."
        }
      ],
