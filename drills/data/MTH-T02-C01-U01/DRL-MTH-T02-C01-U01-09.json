    {
      "category": "Cross-Subject Application",
      "context": "Graphics and Algorithms Application",
      "references": [
        "PRG-T01-C03"
      ],
      "prompt": "In a 2D game engine, points are stored as complex numbers $z = x + yi$. Multiplying by $-1$ rotates a point $180^\\circ$ about the origin. The point $(-3, 1)$ is rotated $180^\\circ$ and then translated by $w = -3 + 5i$. Find the new point $(x', y')$.",
      "display": "z' = -1 \\cdot (-3 + i) + (-3 + 5i)",
      "plainText": "(-1)*(-3 + i) + (-3 + 5i)",
      "answerSpec": {
        "type": "tuple",
        "values": [
          "0",
          "4"
        ],
        "labels": [
          "x'",
          "y'"
        ],
        "acceptComplex": true
      },
      "answerDisplay": "(0, 4)",
      "answerPlain": "(0, 4)",
      "inputHint": "e.g. (5, 3)  or  5 + 3i",
      "checkpointHint": "After the rotation only, the point is $(3, -1)$.",
      "commonTrapTag": "sign-slip",
      "steps": [
        {
          "latex": "z = -3 + i",
          "explain": "Represent the point $(-3, 1)$ as a complex number."
        },
        {
          "latex": "-1\\cdot(-3 + i) = 3 - i",
          "explain": "Multiplying by $-1$ negates both coordinates (a half turn)."
        },
        {
          "latex": "z' = (3 - i) + (-3 + 5i) = 4i",
          "explain": "Add the translation $w$ component-wise. The new point is $(0, 4)$."
        }
      ],
      "id": "Q02",
