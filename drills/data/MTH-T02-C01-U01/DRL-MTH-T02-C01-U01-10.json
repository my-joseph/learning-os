    {
      "category": "Cross-Subject Application",
      "context": "Physics Application: Parallel Impedance",
      "references": [
        "PHY-T01-C19"
      ],
      "prompt": "Two branches with impedances $Z_1 = 1 + 4i$ ohms and $Z_2 = 1 + 6i$ ohms are connected in parallel. Find the equivalent impedance $Z_{eq} = \\dfrac{Z_1 Z_2}{Z_1 + Z_2}$ in standard form $a + bi$.",
      "display": "Z_{eq} = \\frac{(1 + 4i)(1 + 6i)}{(1 + 4i) + (1 + 6i)}",
      "plainText": "((1 + 4i)*(1 + 6i))/((1 + 4i) + (1 + 6i))",
      "answerSpec": {
        "type": "complex",
        "value": "27/52 + (125/52)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "\\frac{27}{52} + \\frac{125}{52}i",
      "answerPlain": "(27/52) + (125/52)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "Compute the product first: $Z_1 Z_2 = -23 + 10i$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "Z_1 Z_2 = (1 + 4i)(1 + 6i) = -23 + 10i",
          "explain": "Multiply the impedances (FOIL, then $i^2 = -1$)."
        },
        {
          "latex": "Z_1 + Z_2 = 2 + 10i",
          "explain": "Add the real parts and the imaginary parts."
        },
        {
          "latex": "Z_{eq} = \\frac{-23 + 10i}{2 + 10i} = \\frac{(-23 + 10i)(2 - 10i)}{(2 + 10i)(2 - 10i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $2 - 10i$ of the denominator."
        },
        {
          "latex": "= \\frac{-46 + 230i + 20i - 100i^2}{2^2 + 10^2}",
          "explain": "Expand the numerator with FOIL. The denominator is $(c + di)(c - di) = c^2 + d^2$ (always a plus sign)."
        },
        {
          "latex": "= \\frac{54 + 250i}{104}",
          "explain": "Substitute $i^2 = -1$ and combine like terms."
        },
        {
          "latex": "= \\frac{27}{52} + \\frac{125}{52}i",
          "explain": "Split into real and imaginary parts and reduce each fraction."
        }
      ],
