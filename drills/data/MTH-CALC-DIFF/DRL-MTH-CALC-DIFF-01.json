        "value": "12*x^2",
        "variables": [
          "x"
        ]
      },
      "answerDisplay": "12x^{2}",
      "answerPlain": "12*x^2",
      "inputHint": "Enter derivative in terms of x (e.g. 6*x^2 or 8*x)",
      "checkpointHint": "Multiply coefficient by power, then decrease exponent by 1.",
      "commonTrapTag": "diff-forgot-decrement-power",
      "steps": [
        {
          "explain": "Apply the power rule $\\frac{d}{dx}[x^n] = n x^{n-1}$.",
          "latex": "\\frac{d}{dx}[4x^{3}] = 4 \\cdot \\frac{d}{dx}[x^{3}]"
        },
        {
          "explain": "Bring down the exponent $3$ and multiply by coefficient $4$.",
          "latex": "= 4 \\cdot (3x^{2})"
        },
        {
          "explain": "Simplify to obtain the final derivative.",
          "latex": "= 12x^{2}"
        }
      ],
