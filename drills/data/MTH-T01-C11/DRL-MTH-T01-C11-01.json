      "steps": [
        {
          "latex": "2n + 3n + 6 + n + 4 = 262 \\implies 6n + 10 = 262",
          "explain": "Expand and combine the variable terms and constants."
        },
        {
          "latex": "6n = 252 \\implies n = 42",
          "explain": "Solve for the smallest even integer $n$."
        },
        {
          "latex": "n + 4 = 42 + 4 = 46",
          "explain": "Add 4 to obtain the largest of the three consecutive even integers."
