    {
      "form": "direct",
      "category": "Reverse Reasoning",
      "context": "Polynomials: FOIL Binomial Expansion & Coefficient Recovery",
      "references": [
        "MTH-T01-C13-U03"
      ],
      "prompt": "Find the positive integer $k$ such that the expansion of $(2x + 4)(4x + k)$ has a linear ($x$) coefficient equal to $22$.",
      "display": "(2x + 4)(4x + k) = 8x^2 + 22x + 4k \\implies k = ?",
      "plainText": "(2*x op 4)*(4*x + 5)",
      "answerSpec": {
        "type": "number",
        "value": "3"
      },
      "answerDisplay": "3",
      "answerPlain": "3",
      "inputHint": "Enter the exact signed integer value",
      "checkpointHint": "Use FOIL (First, Outer, Inner, Last) and combine the Outer and Inner products to form the linear x-term.",
      "commonTrapTag": "c13-foil-middle-term-omission",
      "steps": [
        {
          "latex": "\\text{Linear term} = (2k + 16)x = 22x",
          "explain": "Express the coefficient of $x$ from the Outer and Inner products."
        },
        {
          "latex": "2k = 22 - 16 = 6",
          "explain": "Subtract the Inner product contribution from both sides."
        },
        {
          "latex": "k = \\frac{6}{2} = 3",
          "explain": "Divide by the leading coefficient $a$."
        }
      ],
