          "explain": "Multiply the divisor by the next quotient term."
        },
        {
          "latex": "6x^2-7x+5-(6x^2-3x)=-4x+5",
          "explain": "Subtract the complete product to get the new remainder candidate."
        },
        {
          "latex": "\\frac{-4x}{2x}=-2",
          "explain": "Divide the residual leading terms for the final quotient term."
        },
        {
          "latex": "(2x-1)(-2)=-4x+2",
          "explain": "Multiply the divisor by the final quotient term."
        },
        {
          "latex": "(-4x+5)-(-4x+2)=3",
          "explain": "Subtract to obtain the constant remainder."
        },
        {
          "latex": "q(x)=2x^2+3x-2",
          "explain": "Collect the quotient terms after the final subtraction."
        },
        {
          "latex": "r(x)=3",
          "explain": "State the constant left after the last subtraction."
        },
        {
          "latex": "\\frac{4x^3+4x^2-7x+5}{2x-1}=2x^2+3x-2+\\frac{3}{2x-1}",
          "explain": "Write the quotient together with the remainder over the divisor.",
          "val": "2*x^2+3*x-2+3/(2*x-1)"
