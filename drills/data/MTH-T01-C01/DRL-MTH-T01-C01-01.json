      "prompt": "When the whole number $186$ is divided by a positive divisor $d$, the quotient is $14$ and the remainder is $4$. Find the divisor $d$.",
      "display": "186 = 14d + 4 \\implies d = ?",
      "plainText": "13 * 14 + 4",
      "answerSpec": {
        "type": "number",
        "value": "13"
      },
      "answerDisplay": "13",
      "answerPlain": "13",
      "inputHint": "Enter the exact integer value",
      "checkpointHint": "Use the division algorithm identity connecting dividend, divisor, quotient, and remainder.",
      "commonTrapTag": "c01-remainder-addition-slip",
      "trapDerivation": "13 + 4",
      "steps": [
        {
          "latex": "14d = 186 - 4 = 182",
          "explain": "Subtract the remainder from the dividend."
        },
        {
          "latex": "d = \\frac{182}{14}",
          "explain": "Divide by the quotient to isolate the divisor."
        },
        {
          "latex": "d = 13",
          "explain": "Verify that the remainder is strictly less than the divisor."
        }
