      "commonTrapTag": "c01-order-of-operations-trap",
      "steps": [
        {
          "latex": "C_{\\text{gross}} = 14 \\times 36 + 8 \\times 45 = 864",
          "explain": "Multiply quantity by unit price for each item and sum."
