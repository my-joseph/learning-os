      ],
      "prompt": "In the rectangular coordinate plane, line $L_1$ is given by $y = 2x + 8$ and line $L_2$ is given by $y = -2x + 16$. Find the exact area of the triangle bounded by $L_1$, $L_2$, and the $x$-axis ($y = 0$).",
      "display": "L_1: y = 2x + 8,\\quad L_2: y = -2x + 16,\\quad y = 0 \\implies \\text{Area} = ?",
      "plainText": "coord synthesis direct 72",
      "answerSpec": {
        "type": "number",
        "value": "72"
      },
      "answerDisplay": "72",
      "answerPlain": "72",
      "inputHint": "Enter the exact signed integer value",
      "checkpointHint": "Combine intersection coordinates, perpendicular slope relations, or greatest common divisor step counts to determine the geometric invariant.",
      "commonTrapTag": "c14-lattice-endpoint-exclusion-trap",
      "steps": [
        {
          "latex": "2x + 8 = -2x + 16 \\implies x = 2,\\ y = 12",
          "explain": "Find the intersection vertex of $L_1$ and $L_2$, which gives triangle height $h = y_I$."
        },
        {
          "latex": "x_1 = -4, \\quad x_2 = 8 \\implies \\text{base} = 8 - (-4) = 12",
          "explain": "Find the x-intercepts of both lines and subtract to get the base along the x-axis."
        },
        {
          "latex": "\\text{Area} = \\frac{1}{2} \\times 12 \\times 12 = 72",
          "explain": "Compute half the product of the base and height."
        }
      ],
