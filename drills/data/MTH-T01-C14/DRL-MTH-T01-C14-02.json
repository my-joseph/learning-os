      ],
      "prompt": "Line $L$ has equation $2x + 5y = 70$. How many lattice points $(x, y)$ (points where both $x$ and $y$ are integers) lie on the line segment of $L$ in the first quadrant ($x \\ge 0,\\ y \\ge 0$, including both axis intercepts)?",
      "display": "2x + 5y = 70,\\quad x, y \\in \\mathbb{Z}_{\\ge 0} \\implies N_{\\text{lattice}} = ?",
      "plainText": "coord synthesis lattice-points 8 [epsilon]",
      "answerSpec": {
        "type": "number",
        "value": "8"
      },
      "answerDisplay": "8",
      "answerPlain": "8",
      "inputHint": "Enter the exact signed integer value",
      "checkpointHint": "Combine intersection coordinates, perpendicular slope relations, or greatest common divisor step counts to determine the geometric invariant.",
      "commonTrapTag": "c14-lattice-endpoint-exclusion-trap",
      "steps": [
        {
          "latex": "A = (35, 0), \\quad B = (0, 14)",
          "explain": "Find the x-intercept and y-intercept bounding the first-quadrant segment."
        },
        {
          "latex": "\\gcd(|\\Delta x|, |\\Delta y|) = \\gcd(35, 14) = 7",
          "explain": "Compute the greatest common divisor of the horizontal and vertical spans."
        },
        {
          "latex": "N_{\\text{lattice}} = \\gcd(35, 14) + 1 = 7 + 1 = 8",
          "explain": "Add 1 to include both endpoints of the segment."
        }
      ],
