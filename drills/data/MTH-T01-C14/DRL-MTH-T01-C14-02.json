    {
      "form": "reflection-point",
      "category": "Interleaved Synthesis",
      "context": "Graphs: Coordinate Geometry Multi-Concept Synthesis",
      "references": [
        "MTH-T01-C14-U02",
        "MTH-T01-C14-U03",
        "MTH-T01-C14-U04"
      ],
      "prompt": "Point $P(8, 4)$ is reflected across the line $L: y = 2x + 3$ to its mirror image $P'(x', y')$. Find the sum of coordinates $x' + y'$ of the reflected point.",
      "display": "P(8, 4) \\xrightarrow{\\text{reflect across } y = 2x + 3} P'(x', y') \\implies x' + y' = ?",
      "plainText": "coord synthesis reflection-point 6 [gamma]",
      "answerSpec": {
        "type": "number",
        "value": "6"
      },
      "answerDisplay": "6",
      "answerPlain": "6",
      "inputHint": "Enter the exact signed integer value",
      "checkpointHint": "Combine intersection coordinates, perpendicular slope relations, or greatest common divisor step counts to determine the geometric invariant.",
      "commonTrapTag": "c14-lattice-endpoint-exclusion-trap",
      "steps": [
        {
          "latex": "M = \\left(\\frac{8 + x'}{2}, \\frac{4 + y'}{2}\\right) = (2, 7) \\text{ lies on } L",
          "explain": "The foot of the perpendicular from $P$ to line $L$ is the midpoint $M$ of $PP'$."
        },
        {
          "latex": "x' = 2(2) - 8 = -4, \\quad y' = 2(7) - (4) = 10",
          "explain": "Double the midpoint coordinates and subtract the original coordinates of $P$."
        },
        {
          "latex": "x' + y' = -4 + (10) = 6",
          "explain": "Sum the coordinates of the reflected image $P'$."
        }
      ],
