      ],
      "prompt": "Segment $AB$ has endpoints $A(-2, 1)$ and $B(6, 5)$. Line $L$ is the perpendicular bisector of segment $AB$. Find the $y$-intercept $b$ of line $L$ (where $L$ is written as $y = mx + b$).",
      "display": "A(-2, 1),\\ B(6, 5) \\implies L \\perp AB \\text{ at } M(2, 3) \\implies b = ?",
      "plainText": "coord trap bisector-intercept 7 [zeta]",
      "answerSpec": {
        "type": "number",
        "value": "7"
      },
      "answerDisplay": "7",
      "answerPlain": "7",
      "inputHint": "Enter the exact signed integer value",
      "checkpointHint": "For perpendicular lines use the negative reciprocal slope -1/m; for collinear points equate the slopes of adjacent segments.",
      "commonTrapTag": "c14-perpendicular-slope-sign-trap",
      "steps": [
        {
          "latex": "M = \\left(\\frac{-2 + 6}{2}, \\frac{1 + 5}{2}\\right) = (2, 3)",
          "explain": "Find the midpoint $M$ of segment $AB$."
        },
        {
          "latex": "m_{AB} = \\frac{5 - (1)}{6 - (-2)} = \\frac{1}{2} \\implies m_L = -2",
          "explain": "Take the negative reciprocal of $m_{AB} = 1/2$ to get perpendicular slope $m_L = -2$."
        },
        {
          "latex": "b = y_M - m_L x_M = 3 - (-2)(2) = 7",
          "explain": "Substitute midpoint $M$ into $y = m_L x + b$ to solve for $b$."
        }
      ],
