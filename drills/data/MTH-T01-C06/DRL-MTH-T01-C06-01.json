      "form": "direct",
      "category": "Reverse Reasoning",
      "context": "Percents: Discount & Original Price Recovery",
      "references": [
        "MTH-T01-C06-U03"
      ],
      "prompt": "An item with an original list price of $360$ dollars is discounted by $25\\%$. Find the sale price in dollars.",
      "display": "S = 360 \\times \\left(1 - \\frac{25}{100}\\right)",
      "plainText": "360 * (100 - 25) / 100 = 270 [zeta]",
      "answerSpec": {
        "type": "number",
        "value": "270"
      },
      "answerDisplay": "270",
      "answerPlain": "270",
      "inputHint": "Enter the exact integer value",
      "checkpointHint": "Express the sale price as (100 - discount)% of the original price, then solve for the unknown quantity.",
      "commonTrapTag": "c06-reverse-discount-base-trap",
      "steps": [
        {
          "latex": "\\text{Discount} = \\frac{25}{100} \\times 360 = 90",
          "explain": "Compute the dollar amount of the discount."
        },
        {
          "latex": "S = 360 - 90",
          "explain": "Subtract the discount from the original list price."
        },
        {
          "latex": "S = 270",
          "explain": "State the final sale price."
        }
      ],
