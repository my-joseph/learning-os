      "prompt": "At a conservatory music store, an acoustic cello is offered at a $20\\%$ clearance discount for a final sale price of $480$ dollars. What was the regular retail price of the cello in dollars before the discount?",
      "display": "P_{\\text{orig}} \\times (1 - 0.20) = 480 \\implies P_{\\text{orig}} = ?",
      "plainText": "P * (1 - 0.20) = 480",
      "answerSpec": {
        "type": "number",
        "value": "600"
      },
      "answerDisplay": "600",
      "answerPlain": "600",
      "inputHint": "Enter the original retail price in dollars as an integer",
      "checkpointHint": "Subtract the discount rate from unity to find the paid fraction of the original cost, then divide the sale price by this fraction to recover the initial price.",
      "commonTrapTag": "c06-reverse-discount-base-trap",
      "trapDerivation": "480 * (1 + 20 / 100)",
      "verify": {
        "source": "600",
        "trapValue": "576"
      },
      "steps": [
        {
          "latex": "\\text{Paid Fraction} = 100\\% - 20\\%",
          "explain": "Subtract the discount rate from 100% to determine the paid retention multiplier."
        },
        {
          "latex": "\\text{Paid Fraction} = 80\\%",
          "explain": "Evaluate intermediate step."
        },
        {
          "latex": "\\text{Paid Fraction} = 0.80",
          "explain": "Evaluate intermediate step.",
          "eq": [
            "1 - 0.20",
            "0.80"
          ]
