    {
      "id": "Q04",
      "verificationLevel": "partial",
      "templateKey": "c06-invariant-component-under-variable-total",
      "level": 4,
      "levelLabel": "Level 4 - Applied Synthesis",
      "category": "Interleaved Synthesis",
      "references": [
        "MTH-T01-C06-U02",
