      ],
      "givens": {
        "initial_weight": 200,
        "initial_conc": 40,
        "added_conc": 100,
        "target_conc": 50
      },
      "prompt": "A metalsmith at an artisan jewelry workshop has an ingot of gold alloy weighing $200$ grams with a pure gold concentration of $40\\%$. How many grams of pure $100\\%$ gold must be melted and added into the alloy so that the final gold concentration becomes $50\\%$?",
      "display": "\\frac{200 \\times 40\\% + x}{200 + x} = 50\\% \\implies x = ?",
      "plainText": "(200 * 0.40 + x) / (200 + x) = 0.50",
      "answerSpec": {
        "type": "number",
        "value": "40"
      },
      "answerDisplay": "40",
      "answerPlain": "40",
      "inputHint": "Enter the exact mass of added pure gold in grams",
      "checkpointHint": "Identify the complementary metallic constituent whose absolute mass is unchanged by the addition. Calculate this invariant mass from the initial alloy, then equate it to the complementary fraction of the expanded final mixture.",
      "commonTrapTag": "c06-variable-base-neglect",
      "trapDerivation": "200 * (50 / 100 - 40 / 100)",
      "verify": {
        "source": "40",
        "trapValue": "20"
      },
      "steps": [
        {
          "latex": "M_{\\text{copper}} = 200 \\times (1 - 0.40)",
          "explain": "Determine the mass of copper which remains invariant during the gold addition."
        },
        {
          "latex": "200 \\times (1 - 0.40) = 200 \\times 0.60",
          "explain": "Evaluate intermediate step."
        },
        {
          "latex": "200 \\times 0.60 = 120\\text{ g}",
          "explain": "Evaluate intermediate step.",
          "eq": [
            "200 * 0.60",
            "120"
          ]
        },
        {
          "latex": "120 = (1 - 0.50) \\times M_{\\text{final}}",
          "explain": "Equate invariant copper to the remaining 50% fraction of the expanded final ingot. (Part 1)"
        },
        {
          "latex": "(1 - 0.50) \\times M_{\\text{final}} = 0.50 M_{\\text{final}}",
          "explain": "Evaluate intermediate step."
        },
        {
          "latex": "M_{\\text{final}} = \\frac{120}{0.50}",
          "explain": "Equate invariant copper to the remaining 50% fraction of the expanded final ingot. (Part 2)"
        },
        {
          "latex": "\\frac{120}{0.50} = 240\\text{ g}",
          "explain": "Evaluate intermediate step.",
          "eq": [
            "120 / 0.50",
            "240"
          ]
        },
        {
          "latex": "x = M_{\\text{final}} - 200",
          "explain": "Subtract the initial ingot mass to find the mass of pure gold added."
        },
        {
          "latex": "x = 240 - 200",
          "explain": "Evaluate intermediate step."
        },
        {
          "latex": "x = 40\\text{ g}",
          "explain": "Simplify to obtain 40.",
          "val": "40",
          "eq": [
            "240 - 200",
            "40"
          ]
        }
      ],
