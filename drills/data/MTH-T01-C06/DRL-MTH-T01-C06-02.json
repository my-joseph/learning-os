        {
          "latex": "P_{\\text{orig}} = \\frac{480}{0.80}",
          "explain": "Divide the discounted price by 0.80 to isolate the original base price."
        },
        {
          "latex": "\\frac{480}{0.80} = 600",
          "explain": "Simplify to obtain 600.",
          "val": "600",
          "eq": [
            "480 / 0.80",
            "600"
          ]
        }
      ],
