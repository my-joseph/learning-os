      "commonTrapTag": "c07-ratio-part-vs-whole-trap",
      "steps": [
        {
          "latex": "\\text{Total parts} = 4 + 9 = 13",
          "explain": "Sum the parts of the ratio."
        },
        {
          "latex": "\\text{One part} = \\frac{208}{13} = 16",
          "explain": "Divide the total amount by the sum of the ratio parts."
        },
