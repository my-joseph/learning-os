    {
      "id": "Q01",
      "verificationLevel": "partial",
      "level": 3,
      "category": "Core Skill",
      "archetype": "problem-solving",
      "archetypeKey": "c12-transversal-parallel-angles",
      "context": "high_speed_rail_cant_deflection",
      "prompt": "A railway bypass switch forms a transversal intersecting two parallel tracks. Two consecutive interior angles along the crossing track have algebraic measures of $(3x + 20)^\\circ$ and $(2x + 10)^\\circ$, which sum to a straight line measure of $180^\\circ$. Determine the measure of the larger obtuse interior angle in degrees.",
      "display": "(3x + 20)^\\circ + (2x + 10)^\\circ = 180^\\circ",
      "plainText": "(3x + 20) + (2x + 10) = 180",
      "answerDisplay": "110",
      "answerPlain": "110",
      "givens": {
        "coeff_a": 3,
        "const_a": 20,
        "coeff_b": 2,
        "const_b": 10,
        "straight_sum": 180
      },
      "trapGivens": [
        180,
        20,
        10,
        3,
        2
      ],
      "answerSpec": {
        "type": "number",
        "value": "110",
        "tolerance": 0.001
      },
      "commonTrapTag": "c12-transversal-smaller-angle-trap",
      "trapDerivation": "(180 - (20 + 10)) / (3 + 2) * 2 + 10",
      "trapValue": "70",
      "verify": {
        "source": "110",
        "trapValue": "70"
      },
      "checkpointHint": "Set the sum of consecutive interior angles to straight angle measure, solve for the variable, and substitute back into the algebraic expression for the obtuse angle",
      "references": [
        "MTH-T01-C12"
      ],
      "steps": [
        {
          "latex": "(3x + 20)^\\circ + (2x + 10)^\\circ = 180^\\circ",
          "explain": "Set up consecutive interior angles equation summing to 180 degrees."
        },
        {
          "latex": "3x + 20 + 2x + 10 = 180",
          "explain": "Remove parentheses."
        },
        {
          "latex": "(3x + 2x) + (20 + 10) = 180",
          "explain": "Group like variable terms and constant terms."
        },
        {
          "latex": "5x + (20 + 10) = 180",
          "explain": "Simplify 3x + 2x to 5x."
        },
        {
          "latex": "5x + 30 = 180",
          "explain": "Simplify 20 + 10 to 30."
        },
        {
          "latex": "5x = 180 - 30",
          "explain": "Subtract 30 from both sides."
        },
        {
          "latex": "5x = 150",
          "explain": "Simplify 180 - 30 to 150."
        },
        {
          "latex": "x = \\frac{150}{5}",
          "explain": "Divide both sides by 5."
        },
        {
          "latex": "x = 30",
          "explain": "Simplify 150 / 5 to 30."
        },
        {
          "latex": "\\theta_{\\text{obtuse}} = 3(30)^\\circ + 20^\\circ",
          "explain": "Substitute x = 30 into the larger obtuse angle expression."
        },
        {
          "latex": "\\theta_{\\text{obtuse}} = 90^\\circ + 20^\\circ",
          "explain": "Simplify 3 x 30 to 90."
        },
        {
          "latex": "\\theta_{\\text{obtuse}} = 110^\\circ",
          "explain": "Simplify 90 + 20 to 110 degrees.",
          "val": "110"
        }
      ],
      "form": "direct",
