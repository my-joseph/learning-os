      "archetype": "problem-solving",
      "archetypeKey": "c12-perimeter-rectangles-polygons",
      "context": "solar_farm_inverter_substation_lot",
      "prompt": "A high-voltage solar inverter substation is enclosed by a rectangular security perimeter of $96$ meters. The length of the enclosure is $3$ times its width. Accounting for the $2$ pairs of opposing boundary sides, determine the total land area enclosed by the substation in square meters.",
      "display": "P = 2(3W) + 2W = 96",
      "plainText": "2*(3*w) + 2*w = 96",
      "answerDisplay": "432",
      "answerPlain": "432",
      "givens": {
        "perimeter": 96,
        "ratio": 3,
        "sides": 2
      },
      "trapGivens": [
        96,
        3,
        2
      ],
      "answerSpec": {
        "type": "number",
        "value": "432",
        "tolerance": 0.001
      },
      "commonTrapTag": "c12-perimeter-length-only-trap",
      "trapDerivation": "(96 / (2 * 3 + 2)) * 3",
      "trapValue": "36",
      "verify": {
        "source": "432",
        "trapValue": "36"
      },
      "checkpointHint": "Express length in terms of width, substitute into perimeter equation to isolate width, compute both dimensions, and multiply to find total area",
      "references": [
        "MTH-T01-C12"
      ],
      "steps": [
        {
          "latex": "2L + 2W = 96",
          "explain": "State the perimeter formula for the rectangular enclosure."
        },
        {
          "latex": "2(3W) + 2W = 96",
          "explain": "Substitute length as 3 times width."
        },
        {
          "latex": "6W + 2W = 96",
          "explain": "Simplify 2 x 3W to 6W."
        },
        {
          "latex": "8W = 96",
          "explain": "Combine like terms 6W + 2W to 8W."
        },
        {
          "latex": "W = \\frac{96}{8}",
          "explain": "Divide both sides by 8."
        },
        {
          "latex": "W = 12\\text{ m}",
          "explain": "Simplify 96 / 8 to 12 meters."
        },
        {
          "latex": "L = 3 \\times 12",
          "explain": "Calculate length using L = 3W."
        },
        {
          "latex": "L = 36\\text{ m}",
          "explain": "Simplify 3 x 12 to 36 meters."
        },
        {
          "latex": "A = L \\times W",
          "explain": "State the rectangle area formula."
        },
        {
          "latex": "A = 36 \\times 12",
          "explain": "Substitute length 36 and width 12."
        },
        {
          "latex": "A = 432\\text{ m}^2",
          "explain": "Multiply 36 by 12 to find enclosed area in square meters.",
          "val": "432"
        }
      ],
