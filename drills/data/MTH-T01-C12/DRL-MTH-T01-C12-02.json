    {
      "form": "direct",
      "category": "Interleaved Synthesis",
      "context": "Geometry: Circles & Lunes of Hippocrates",
      "references": [
        "MTH-T01-C12-U04",
        "MTH-T01-C12-U05"
      ],
      "prompt": "A square of side length $s = 6$ is inscribed inside a circle. Four semicircles are drawn externally on the four sides of the square as diameters. The region outside the circumscribed circle but inside the four semicircles forms four crescent-shaped regions known as the Lunes of Hippocrates. Find the exact total area of all four lunes.",
      "display": "\\text{Lunes of Hippocrates on square of side } s = 6 \\implies \\text{Total Area} = ?",
      "plainText": "6^2 + 18*pi - 18*pi",
      "answerSpec": {
        "type": "number",
        "value": "36"
      },
      "answerDisplay": "36",
      "answerPlain": "36",
      "inputHint": "Enter the integer area (pi cancels out!)",
      "checkpointHint": "Calculate the total area of the four semicircles plus the area of the square, then subtract the area of the circumscribed circle. Notice how the terms involving $\\pi$ cancel out.",
      "commonTrapTag": "pi-retained-in-lunes-trap",
      "steps": [
        {
          "latex": "A_{\\text{square}} = 6^2 = 36",
          "explain": "The inscribed square has area $6 \\times 6 = 36$."
        },
        {
          "latex": "R = \\frac{6\\sqrt{2}}{2} = 3\\sqrt{2} \\implies A_{\\text{circle}} = \\pi(3\\sqrt{2})^2 = 18\\pi",
          "explain": "The diameter of the circumscribed circle is the diagonal of the square."
        },
        {
          "latex": "A_{\\text{4 semicircles}} = 4 \\times \\left(\\frac{1}{2}\\pi (3)^2\\right) = 18\\pi",
          "explain": "Each side of length 6 is the diameter of a semicircle with radius 3."
        },
        {
          "latex": "A_{\\text{lunes}} = (A_{\\text{square}} + A_{\\text{4 semicircles}}) - A_{\\text{circle}} = (36 + 18\\pi) - 18\\pi = 36",
          "explain": "The area of the circumscribed circle perfectly cancels the area of the four semicircles, leaving exactly the area of the square!"
        }
      ],
