    {
      "form": "direct",
      "category": "Trap & Edge Case",
      "context": "Geometry: Altitude & Inscribed Circle",
      "references": [
        "MTH-T01-C12-U03"
      ],
      "prompt": "In a right-angled triangle $ABC$ with right angle at $C$ and hypotenuse $AB = 25$, altitude $CD$ is drawn perpendicular to $AB$, dividing the hypotenuse into two segments $AD = 9$ and $DB = 16$. A circle is inscribed inside triangle $ACD$. Find the radius $r$ of this inscribed circle.",
      "display": "\\triangle ABC: \\angle C = 90^\\circ,\\ AB = 25,\\ CD \\perp AB,\\ AD = 9,\\ DB = 16 \\implies r_{\\text{in}}(\\triangle ACD) = ?",
      "plainText": "(9 + sqrt(9*16) - sqrt(9^2 + 9*16)) / 2",
      "answerSpec": {
        "type": "number",
        "value": "3"
      },
      "answerDisplay": "3",
      "answerPlain": "3",
      "inputHint": "Enter the integer radius of the inscribed circle",
      "checkpointHint": "Use the Geometric Mean Theorem to find altitude $CD = \\sqrt{AD \\cdot DB}$. Then apply the Pythagorean theorem on $\\triangle ACD$ to find leg $AC$. Finally, use the right triangle inradius formula $r = \\frac{a + b - c}{2}$.",
      "commonTrapTag": "whole-triangle-inradius-confusion",
      "trapDerivation": "(15 + 20 - 25) / 2",
      "steps": [
        {
          "latex": "CD^2 = AD \\cdot DB = 9 \\cdot 16 = 144 \\implies CD = 12",
          "explain": "The altitude to the hypotenuse satisfies $CD^2 = AD \\cdot DB$."
        },
        {
          "latex": "AC = \\sqrt{AD^2 + CD^2} = \\sqrt{9^2 + 12^2} = 15",
          "explain": "Apply the Pythagorean theorem on right triangle $\\triangle ACD$."
        },
        {
          "latex": "r = \\frac{AD + CD - AC}{2} = \\frac{9 + 12 - 15}{2} = 3",
          "explain": "For any right triangle with legs $a, b$ and hypotenuse $c$, the inradius is $r = \\frac{a + b - c}{2}$."
        }
      ],
      "level": 3,
      "skill": "GEO-RIGHT-TRIANGLE-APPLIED",
      "verificationLevel": "machine-verified",
      "id": "Q05",
