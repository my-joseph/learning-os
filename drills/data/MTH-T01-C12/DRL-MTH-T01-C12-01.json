      "form": "from-diameter",
      "category": "Trap & Edge Case",
      "context": "Geometry: 3D Conical Frustum from Diameter",
      "references": [
        "MTH-T01-C12-U06"
      ],
      "prompt": "A right circular cone has base diameter $D = 24$ and total height $H = 16$. The cone is truncated by a plane parallel to the base at a distance of $h = 4$ above the base, forming a conical frustum. Find the exact volume of this frustum in terms of $\\pi$.",
      "display": "\\text{Frustum of Cone: } D = 24,\\ H = 16,\\ h = 4 \\implies V = ?",
      "plainText": "(1/3)*pi*((24/2)^2)*16 - (1/3)*pi*((9)^2)*12",
      "answerSpec": {
        "type": "expression",
        "value": "444*pi",
        "variables": [
          "pi"
        ]
      },
      "answerDisplay": "444\\pi",
      "answerPlain": "444 pi",
      "inputHint": "Enter exact form with pi, e.g. 150 pi or 150*pi",
      "checkpointHint": "Halve the base diameter to get $R = D/2$, use similar triangles to determine the top cone radius at height $H - h$, and subtract the top cone volume from the full cone volume.",
      "commonTrapTag": "frustum-cylinder-average-trap",
      "steps": [
        {
          "latex": "R = \\frac{24}{2} = 12, \\quad h_{\\text{top}} = 16 - 4 = 12 \\implies r_{\\text{top}} = 12 \\times \\frac{12}{16} = 9",
          "explain": "Convert diameter to radius $R = 12$ and find top cone radius $r_{\\text{top}} = 9$ by similar triangles."
        },
        {
          "latex": "V_{\\text{total}} = \\frac{1}{3}\\pi (12^2)(16) = 768\\pi, \\quad V_{\\text{top}} = \\frac{1}{3}\\pi (9^2)(12) = 324\\pi",
          "explain": "Compute volumes of original cone and removed top cone via $V = \\frac{1}{3}\\pi r^2 h$."
        },
        {
          "latex": "V_{\\text{frustum}} = V_{\\text{total}} - V_{\\text{top}} = 768\\pi - 324\\pi = 444\\pi",
          "explain": "Subtract volumes: $768\\pi - 324\\pi = 444\\pi$."
        }
      ],
