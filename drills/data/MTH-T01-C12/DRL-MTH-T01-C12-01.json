    {
      "form": "direct",
      "category": "Interleaved Synthesis",
      "context": "Geometry: Circles & Lunes of Hippocrates",
      "references": [
        "MTH-T01-C12-U04",
        "MTH-T01-C12-U05"
      ],
      "prompt": "A square of side length $s = 18$ is inscribed inside a circle. Four semicircles are drawn externally on the four sides of the square as diameters. The region outside the circumscribed circle but inside the four semicircles forms four crescent-shaped regions known as the Lunes of Hippocrates. Find the exact total area of all four lunes.",
      "display": "\\text{Lunes of Hippocrates on square of side } s = 18 \\implies \\text{Total Area} = ?",
      "plainText": "18^2 + 162*pi - 162*pi",
      "answerSpec": {
        "type": "number",
        "value": "324"
      },
      "answerDisplay": "324",
      "answerPlain": "324",
      "inputHint": "Enter the integer area (pi cancels out!)",
      "checkpointHint": "Calculate the total area of the four semicircles plus the area of the square, then subtract the area of the circumscribed circle. Notice how the terms involving $\\pi$ cancel out.",
      "commonTrapTag": "pi-retained-in-lunes-trap",
      "trapDerivation": "324 / 2",
      "steps": [
        {
          "latex": "A_{\\text{square}} = 18^2 = 324",
          "explain": "The inscribed square has area $18 \\times 18 = 324$."
        },
        {
          "latex": "R = \\frac{18\\sqrt{2}}{2} = 9\\sqrt{2} \\implies A_{\\text{circle}} = \\pi(9\\sqrt{2})^2 = 162\\pi",
          "explain": "The diameter of the circumscribed circle is the diagonal of the square."
        },
        {
          "latex": "A_{\\text{4 semicircles}} = 4 \\times \\left(\\frac{1}{2}\\pi (9)^2\\right) = 162\\pi",
          "explain": "Each side of length 18 is the diameter of a semicircle with radius 9."
        },
        {
          "latex": "A_{\\text{lunes}} = (A_{\\text{square}} + A_{\\text{4 semicircles}}) - A_{\\text{circle}} = (324 + 162\\pi) - 162\\pi = 324",
          "explain": "The area of the circumscribed circle perfectly cancels the area of the four semicircles, leaving exactly the area of the square!"
        }
      ],
