    {
      "id": "Q02",
      "level": 5,
      "levelLabel": "Level 5 - Non-Routine Synthesis",
      "category": "Interleaved Synthesis",
      "archetypeKey": "syn-c12-c09-c05-annulus-inscribed-circle-radical",
      "skill": "GEO-RIGHT-TRIANGLE-LEG",
      "context": "hydraulic_cylinder_seal_gasket",
      "prompt": "A hydraulic cylinder seal gasket is manufactured as a circular annulus with outer radius $R = 15$ mm and inner radius $r = 12$ mm. Determine the cross-sectional ring area $A_{\\text{ring}} = \\pi (R^2 - r^2)$ using $\\pi \\approx 3.14159$ and round to one decimal place.",
      "display": "A_{\\text{ring}} = 3.14159 \\times (15^2 - 12^2)",
      "plainText": "A_ring = 3.14159 * (15^2 - 12^2)",
      "givens": {
        "R": 15,
        "r": 12,
        "pi_approx": 3.14159
      },
      "steps": [
        {
          "latex": "R^2 - r^2 = 15^2 - 12^2",
          "explain": "Substitute outer and inner radii into difference of squares."
        },
        {
          "latex": "R^2 - r^2 = 225 - 12^2",
          "explain": "Evaluate 15^2 to 225."
        },
        {
          "latex": "R^2 - r^2 = 225 - 144",
          "explain": "Evaluate 12^2 to 144."
        },
        {
          "latex": "R^2 - r^2 = 81",
          "explain": "Simplify 225 - 144 to 81."
        },
        {
          "latex": "A_{\\text{ring}} = 3.14159 \\times 81",
          "explain": "Multiply radius difference by pi approximation."
        },
        {
          "latex": "A_{\\text{ring}} = 254.46879",
          "explain": "Compute the multiplication."
        },
        {
          "latex": "A_{\\text{ring}} = 254.5",
          "explain": "Round final area to one decimal place.",
          "val": "254.5"
        }
      ],
