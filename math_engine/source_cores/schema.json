{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningos.local/schemas/source-core-card.schema.json",
  "title": "Source Core Card",
  "description": "Abstract, source-free mathematical problem core extracted from an allowed source family. No field may contain source wording, source numbers, or exceed 200 characters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "unitCode",
    "sourceRef",
    "skill",
    "reasoningMove",
    "difficultyDriver",
    "level",
    "traps",
    "format",
    "representation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "unitCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "laterUnit": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "units": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "file", "page", "item"],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "page": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "minLength": 1, "maxLength": 200 }
          ]
        },
        "item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "skill": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reasoningMove": {
      "type": "string",
      "enum": [
        "direct",
        "chain",
        "reverse",
        "translate",
        "diagnose",
        "multi-relation",
        "case-check",
        "generalise",
        "model"
      ]
    },
    "operations": {
      "type": "array",
      "description": "Ordered sequence of distinct taught sub-skill names applied in sequence (minItems 2 when present; required when reasoningMove is 'chain').",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "flawForm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S",
      "description": "Source-free description of the given work and its wrong step. Required when reasoningMove is diagnose."
    },
    "difficultyDriver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "traps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "description"],
        "properties": {
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["choice", "numeric", "expression", "proof-lite"]
        },
        "optionCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "distractorPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "representation": {
      "type": "string",
      "enum": ["symbolic", "graph/plane", "table", "verbal"]
    },
    "notes": {
      "type": "string",
      "maxLength": 200
    }
  },
  "if": {
    "properties": {
      "reasoningMove": { "const": "chain" }
    },
    "required": ["reasoningMove"]
  },
  "then": {
    "required": ["operations"],
    "properties": {
      "level": { "const": 2 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "reasoningMove": { "const": "direct" } }, "required": ["reasoningMove"] },
      "then": { "properties": { "level": { "maximum": 2 } } }
    },
    {
      "if": { "properties": { "reasoningMove": { "enum": ["translate", "reverse"] } }, "required": ["reasoningMove"] },
      "then": { "properties": { "level": { "minimum": 2 } } }
    },
    {
      "if": { "properties": { "reasoningMove": { "enum": ["case-check", "diagnose", "model", "multi-relation", "generalise"] } }, "required": ["reasoningMove"] },
      "then": { "properties": { "level": { "minimum": 3 } } }
    },
    {
      "if": { "properties": { "reasoningMove": { "const": "diagnose" } }, "required": ["reasoningMove"] },
      "then": { "required": ["flawForm"] }
    }
  ]
}
