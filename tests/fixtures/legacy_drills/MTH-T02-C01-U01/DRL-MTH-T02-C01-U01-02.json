    {
      "category": "Core Skill",
      "prompt": "Divide and write the quotient in standard form $a + bi$.",
      "display": "\\frac{-5 + 4i}{2 + i}",
      "plainText": "(-5 + 4i)/(2 + i)",
      "answerSpec": {
        "type": "complex",
        "value": "-6/5 + (13/5)*I",
        "forms": [
          "a+bi",
          "reduced_fraction"
        ]
      },
      "answerDisplay": "-\\frac{6}{5} + \\frac{13}{5}i",
      "answerPlain": "(-6/5) + (13/5)i",
      "inputHint": "Standard form, e.g. 3 - 4i or -8/17 + 15/17 i",
      "checkpointHint": "The new denominator is $2^2 + 1^2 = 5$.",
      "commonTrapTag": "conjugate-denominator",
      "steps": [
        {
          "latex": "\\frac{-5 + 4i}{2 + i} = \\frac{(-5 + 4i)(2 - i)}{(2 + i)(2 - i)}",
          "explain": "Multiply the numerator and denominator by the conjugate $2 - i$ of the denominator."
        },
        {
          "latex": "= \\frac{-10 + 5i + 8i - 4i^2}{2^2 + 1^2}",
          "explain": "Expand the numerator with FOIL. The denominator is $(c + di)(c - di) = c^2 + d^2$ (always a plus sign)."
        },
        {
          "latex": "= \\frac{-6 + 13i}{5}",
          "explain": "Substitute $i^2 = -1$ and combine like terms."
        },
        {
          "latex": "= -\\frac{6}{5} + \\frac{13}{5}i",
          "explain": "Split into real and imaginary parts and reduce each fraction."
        }
      ],
      "id": "Q01",
      "templateKey": "divide-conjugate",
      "level": 2,
      "levelLabel": "Level 2 - Standard Exam",
