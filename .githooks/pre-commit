#!/bin/sh
# LearningOS: no commits on main. Work on a branch and open a PR (CLAUDE.md "Workflow").
branch=$(git symbolic-ref --short -q HEAD)
if [ "$branch" = "main" ]; then
  echo "BLOCKED: you are committing on 'main'. Every change goes through a branch and a PR:" >&2
  echo "  git switch -c <type>/<short-name>   # then commit, push, gh pr create" >&2
  echo "Drill-only PRs (drill file, its unit's vault, id_map.json) may be merged by the agent; anything else waits for the learner's \"merge\"." >&2
  exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Secrets never leave the machine: .env and .env.* are gitignored; this also stops `git add -f`.
secrets=$(printf '%s\n' "$staged" | grep -E '(^|/)\.env(\.|$)' || true)
if [ -n "$secrets" ]; then
  echo "BLOCKED: secret/environment files (.env, .env.*) must never be committed:" >&2
  echo "$secrets" >&2
  echo "Unstage them: git restore --staged <file>" >&2
  exit 1
fi

# Answers never leave the machine: pilot/ (stand-in learner solutions) and scratch/ (blind-solve and
# reviewer files) hold drill answers. They are gitignored; this also stops `git add -f`.
leaked=$(printf '%s\n' "$staged" | grep -E '^(pilot|scratch)/' || true)
if [ -n "$leaked" ]; then
  echo "BLOCKED: these files hold answers and are never committed:" >&2
  echo "$leaked" >&2
  echo "Unstage them: git restore --staged <file>" >&2
  exit 1
fi

# Local-only learner/source/issue state must never be committed even with `git add -f`.
local_only=$(printf '%s\n' "$staged" | grep -E '^(progress|sources|issues)/' || true)
if [ -n "$local_only" ]; then
  echo "BLOCKED: local-only data (progress/, sources/, issues/) must never be committed:" >&2
  echo "$local_only" >&2
  echo "Unstage them: git restore --staged <file>" >&2
  exit 1
fi
